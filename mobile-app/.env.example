EXPO_PUBLIC_DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key
EXPO_PUBLIC_DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
EXPO_PUBLIC_DEEPSEEK_MODEL=deepseek-chat

# Xfyun super-human text-to-speech for Today's Brief listening.
# Keep these in your local .env only. Do not commit real values.
EXPO_PUBLIC_XFYUN_TTS_APP_ID=replace_with_your_xfyun_app_id
EXPO_PUBLIC_XFYUN_TTS_API_KEY=replace_with_your_xfyun_api_key
EXPO_PUBLIC_XFYUN_TTS_API_SECRET=replace_with_your_xfyun_api_secret
EXPO_PUBLIC_XFYUN_TTS_URL=wss://cbm01.cn-huabei-1.xf-yun.com/v1/private/mcd9m97e6
EXPO_PUBLIC_XFYUN_TTS_VOICE=x5_lingxiaoxuan_flow
EXPO_PUBLIC_XFYUN_TTS_SPEED=45
EXPO_PUBLIC_XFYUN_TTS_VOLUME=70
EXPO_PUBLIC_XFYUN_TTS_PITCH=50

# Juhe real news feed for Today's Brief.
# Keep the real key in your local .env only.
EXPO_PUBLIC_JUHE_NEWS_KEY=replace_with_your_juhe_news_key
EXPO_PUBLIC_JUHE_NEWS_BASE_URL=https://v.juhe.cn/toutiao
EXPO_PUBLIC_JUHE_NEWS_TYPES=guoji,keji,caijing
EXPO_PUBLIC_JUHE_NEWS_PAGE_SIZE=10
EXPO_PUBLIC_JUHE_NEWS_PAGE_COUNT=2

# Supabase account sync for sharing login and saved items with the HQ website.
# Use the public project URL and anon public key only. Never put service_role keys in Expo env.
EXPO_PUBLIC_SUPABASE_URL=replace_with_your_supabase_project_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace_with_your_supabase_anon_key
